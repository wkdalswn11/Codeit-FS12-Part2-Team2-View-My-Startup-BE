generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int          @id @default(autoincrement())
  name        String
  email       String       @unique
  comparisons Comparison[]
  favorites   Favorite[]
  investments Investment[]
}

model Company {
  id             Int             @id @default(autoincrement())
  name           String
  businessNumber String          @unique
  address        String
  description    String
  revenue        Int
  employeeCount  Int
  categoryName   CompanyCategory
  logo           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  baseInvestment Int             @default(0)
  siteInvestment Int             @default(0)
  compareCount   Int             @default(0)
  favoriteCount  Int             @default(0)
  comparisons    Comparison[]
  favorites      Favorite[]
  investments    Investment[]
}

model Investment {
  id        Int              @id @default(autoincrement())
  userId    Int
  companyId Int
  amount    Int
  comment   String
  status    InvestmentStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  company   Company          @relation(fields: [companyId], references: [id])
  user      User             @relation(fields: [userId], references: [id])

  @@unique([userId, companyId])
}

model Favorite {
  id             Int      @id @default(autoincrement())
  userId         Int
  companyId      Int
  createdAt      DateTime @default(now())
  isActive       Boolean  @default(false)
  lastSelectedAt DateTime @default(now())
  company        Company  @relation(fields: [companyId], references: [id])
  user           User     @relation(fields: [userId], references: [id])

  @@unique([userId, companyId])
}

model Comparison {
  id        Int      @id @default(autoincrement())
  userId    Int
  companyId Int
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, companyId])
}

enum CompanyCategory {
  IT
  FINANCE
  HEALTHCARE
  EDUCATION
  ECOMMERCE
  OTHER
}

enum InvestmentStatus {
  PENDING
  APPROVED
  REJECTED
}
